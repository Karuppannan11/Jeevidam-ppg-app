{
  "expo": {
    "name": "Jeevidam Group App",
    "slug": "ppg-fpo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/applogoforjeev.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/applogoforjeev.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true,
      "package": "com.ictinayam.ppgfpo",
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_NETWORK_STATE",
        "VIBRATE",
        "SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "034b3df4-3548-426a-91da-0876c2775e01"
      }
    },
    "owner": "ictinayam",
    "plugins": [
      "@react-native-community/datetimepicker"
    ]
  }
}
